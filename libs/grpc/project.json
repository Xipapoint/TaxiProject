{
  "name": "grpc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/grpc/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project grpc --web",
  "targets": {
    "generate-proto-types": {
      "command": "protoc --plugin=../../../../node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./types ./protos/*.proto --ts_proto_opt=nestJs=true --ts_proto_opt=exportCommonSymbols=false",
      "options": {
        "cwd": "{projectRoot}/src/lib"
      }
    }
  }
}
